{
  "name": "dotenvdotenc",
  "version": "0.2.0",
  "description": "dede: keep gitignored .env* files in sync with committed dotenvx-encrypted .env*.enc twins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snomiao/dotenvdotenc.git"
  },
  "keywords": [
    "dotenv",
    "dotenvx",
    "env",
    "encryption",
    "secrets",
    "git"
  ],
  "type": "module",
  "release": {
    "branches": [
      "main"
    ]
  },
  "files": [
    "dede.ts",
    "primitives.d.ts"
  ],
  "bin": {
    "dede": "dede.ts"
  },
  "scripts": {
    "test": "bun --no-env-file test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/primitives": "3.0.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.31.1",
    "@types/bun": "1.3.3",
    "typescript": "5.9.3"
  }
}
